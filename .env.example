# URL du projet Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cle service_role du projet Supabase (Project Settings > API > service_role secret)
# Utilisee uniquement cote serveur, jamais exposee au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Port local du serveur Express
PORT=3000

# Cle API YouTube Data API v3 (Google Cloud Console > APIs & Services > Credentials)
# Sans cette cle, la source YouTube est simplement ignoree (les 3 autres sources continuent de fonctionner).
YOUTUBE_API_KEY=
